# Copy to .env and fill in. Never commit the real .env file.
# All credentials are loaded from environment variables only — see
# ictagent/config/settings.py. Nothing in this repo hardcodes a secret.

# ---------------------------------------------------------------------------
# Trading phase / execution gate (see ictagent/config/settings.py)
#
# ICTAGENT_PHASE controls what the execution/ layer is allowed to do:
#   paper       -> log-only / simulated fills, no broker orders sent (default)
#   semi_auto   -> agent proposes trades, a human must confirm each one
#   autonomous  -> fully automated order placement
#
# ICTAGENT_LIVE_TRADING_CONFIRM must be set to the exact literal string
# "I_UNDERSTAND_THIS_IS_LIVE_MONEY" for phase=autonomous (or semi_auto order
# confirmation) to be permitted to touch a live broker endpoint. This is
# intentionally two separate variables so a single flipped flag can never
# turn on live trading by accident.
ICTAGENT_PHASE=paper
ICTAGENT_LIVE_TRADING_CONFIRM=

# ---------------------------------------------------------------------------
# Zerodha Kite Connect (Indian equities + index F&O)
# KITE_ACCESS_TOKEN expires after roughly one trading day — it must be
# regenerated daily via the login flow (see ictagent/data/kite.py:
# KiteClient.login_url() / generate_session()). Leave it blank and call
# generate_session() yourself if you don't have a same-day token handy.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OANDA v20 REST API (forex)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live — OANDA has physically separate endpoints per environment
OANDA_ENVIRONMENT=practice

# ---------------------------------------------------------------------------
# Claude API (agent/ reasoning layer)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional: economic calendar / news providers (context/ module)
NEWS_API_KEY=
